node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- IDE / OS ----
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
