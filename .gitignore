# ---- C++ / CMake ----
build/
build-*/
out/
cmake-build-*/
*.o
*.obj
*.a
*.lib
*.exe
# ...but the shipped challenge executables are real artifacts and must be committed
!challenges/**/*.exe
*.pdb
*.ilk
CMakeUserPresets.json

# ---- Runtime data & secrets (never commit) ----
data/runtime/
!data/runtime/.gitkeep
*.secret
secret.txt
server_secret*
.env
.env.*

